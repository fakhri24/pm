# Copy to .env and fill in real values. .env is gitignored.

# OpenRouter API key for the AI chat feature.
OPENROUTER_API_KEY=

# JWT signing key. Use a long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
# If unset, a random key is generated at startup (tokens will not survive a restart).
SECRET_KEY=
